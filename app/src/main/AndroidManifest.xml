<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- SMS capture is optional; manual entry works without telephony hardware. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".AwareApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_cosy"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_cosy"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aware">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity-alias
            android:name=".launcher.OatLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cosy"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cosy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.SageRoseLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sage_rose"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sage_rose"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.PlumHearthLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_plum_hearth"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_plum_hearth"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.MaximalLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_maximal"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_maximal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.LinenCafeLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_linen_cafe"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_linen_cafe"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.NavyTideLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navy_tide"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_navy_tide"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.CharcoalLeatherLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_charcoal_leather"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_charcoal_leather"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".sms.TransactionSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="100">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.AwareWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aware_widget_info" />
        </receiver>

        <service
            android:name=".notifications.PaymentNotificationListener"
            android:exported="false"
            android:label="Payment notification capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
