    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M3,14 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z
                          M6,14 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.5,8.5 h3 v11 h-3 Z" />
</vector>
