<!--
  Maximal mark: the same "a", wearing the skin's signature hard offset shadow
  plus a glitch slice through the bowl. Drawn back-to-front: magenta ghost,
  lime letter, then the slice.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Offset ghost, echoing StencilText in the app. -->
    <path
        android:fillColor="#FF4FD8"
        android:fillType="evenOdd"
        android:pathData="M31,67 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 Z
                          M42,67 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
    <path
        android:fillColor="#FF4FD8"
        android:pathData="M68,46 h11 v42 h-11 Z" />

    <!-- The letter. -->
    <path
        android:fillColor="#C6FF3D"
        android:fillType="evenOdd"
        android:pathData="M25,62 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 Z
                          M36,62 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
    <path
        android:fillColor="#C6FF3D"
        android:pathData="M62,41 h11 v42 h-11 Z" />

    <!-- Glitch slice: a hard cut across the bowl, shifted off-axis. -->
    <path
        android:fillColor="#08080A"
        android:pathData="M20,57 h58 v6 h-58 Z" />
    <path
        android:fillColor="#35D8FF"
        android:pathData="M30,57 h34 v6 h-34 Z" />
</vector>
